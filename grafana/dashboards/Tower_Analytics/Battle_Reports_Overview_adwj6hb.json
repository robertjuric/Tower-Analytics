          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  r.battle_date,\r\n  r.tier,\r\n  r.wave,\r\n  r.coins_earned,\r\n  r.coins_per_hour,\r\n  r.cells_earned,\r\n  r.cells_per_hour,\r\n  r.killed_by,\r\n  r.game_time_seconds,\r\n  r.real_time_seconds,\r\n  STRING_AGG(t.name, ', ') AS tags\r\nFROM battle_reports r\r\nLEFT JOIN battle_report_tags rt ON r.id = rt.report_id\r\nLEFT JOIN tags t ON rt.tag_id = t.id\r\nGROUP BY r.id\r\nORDER BY r.battle_date DESC;",
          "refId": "A",
