          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  r.battle_date AS time,\r\n  r.coins_earned\r\nFROM battle_reports r\r\nJOIN battle_report_tags rt ON r.id = rt.report_id\r\nJOIN tags t ON rt.tag_id = t.id\r\nWHERE t.name IN (${tag:sqlstring})\r\nAND NOT EXISTS (\r\n  SELECT 1\r\n  FROM battle_report_tags rt\r\n  JOIN tags t ON rt.tag_id = t.id\r\n  WHERE rt.report_id = r.id\r\n    AND t.name IN ('dissonance', 'tournament', 'mission')\r\n)\r\nORDER BY time;",
          "refId": "A",
