          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  r.battle_date AS time,\r\n  e.value AS golden_bot_coins\r\nFROM battle_reports r\r\nJOIN battle_economy e ON r.id = e.report_id\r\nWHERE e.category = 'coins'\r\n  AND e.metric = 'golden_bot'\r\n  AND NOT EXISTS (\r\n  SELECT 1\r\n  FROM battle_report_tags rt\r\n  JOIN tags t ON rt.tag_id = t.id\r\n  WHERE rt.report_id = r.id\r\n    AND t.name IN ('dissonance', 'tournament', 'mission')\r\n)\r\nORDER BY time;",
