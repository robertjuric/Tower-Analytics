          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  r.battle_date AS time,\r\n\r\n  MAX(CASE WHEN e.metric = 'gems' THEN e.value END) AS gems,\r\n  MAX(CASE WHEN e.metric = 'ad_gems' THEN e.value END) AS ad_gems,\r\n  MAX(CASE WHEN e.metric = 'fetch_gems' THEN e.value END) AS fetch_gems,\r\n  MAX(CASE WHEN e.metric = 'gem_blocks_tapped' THEN e.value END) AS gem_blocks_tapped,\r\n  MAX(CASE WHEN e.metric = 'medals' THEN e.value END) AS medals\r\n\r\nFROM battle_reports r\r\nJOIN battle_economy e ON r.id = e.report_id\r\n\r\nWHERE e.category = 'currencies'\r\n  AND $__timeFilter(r.battle_date)\r\n  AND e.metric IN (\r\n    'gems',\r\n    'ad_gems',\r\n    'fetch_gems',\r\n    'gem_blocks_tapped',\r\n    'medals'\r\n  )\r\n  AND NOT EXISTS (\r\n    SELECT 1\r\n    FROM battle_report_tags rt\r\n    JOIN tags t ON rt.tag_id = t.id\r\n    WHERE rt.report_id = r.id\r\n      AND t.name IN ('dissonance', 'tournament', 'mission')\r\n  )\r\n\r\nGROUP BY r.battle_date\r\nORDER BY time;",
