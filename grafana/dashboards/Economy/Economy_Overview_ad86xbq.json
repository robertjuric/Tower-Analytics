          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  r.battle_date AS time,\r\n\r\n  MAX(CASE WHEN e.metric = 'reroll_shards_earned' THEN e.value END) AS reroll_shards_earned,\r\n  MAX(CASE WHEN e.metric = 'reroll_shards_fetched' THEN e.value END) AS reroll_shards_fetched,\r\n  MAX(CASE WHEN e.metric = 'cannon_shards' THEN e.value END) AS cannon_shards,\r\n  MAX(CASE WHEN e.metric = 'armor_shards' THEN e.value END) AS armor_shards,\r\n  MAX(CASE WHEN e.metric = 'generator_shards' THEN e.value END) AS generator_shards,\r\n  MAX(CASE WHEN e.metric = 'core_shards' THEN e.value END) AS core_shards,\r\n  MAX(CASE WHEN e.metric = 'common_modules' THEN e.value END) AS common_modules,\r\n  MAX(CASE WHEN e.metric = 'rare_modules' THEN e.value END) AS rare_modules\r\n\r\nFROM battle_reports r\r\nJOIN battle_economy e ON r.id = e.report_id\r\n\r\nWHERE e.category = 'currencies'\r\n  AND $__timeFilter(r.battle_date)\r\n  AND e.metric IN (\r\n    'reroll_shards_earned',\r\n    'reroll_shards_fetched',\r\n    'cannon_shards',\r\n    'armor_shards',\r\n    'generator_shards',\r\n    'core_shards',\r\n    'common_modules',\r\n    'rare_modules'\r\n  )\r\n  AND NOT EXISTS (\r\n    SELECT 1\r\n    FROM battle_report_tags rt\r\n    JOIN tags t ON rt.tag_id = t.id\r\n    WHERE rt.report_id = r.id\r\n      AND t.name IN ('dissonance', 'tournament', 'mission')\r\n  )\r\n\r\nGROUP BY r.battle_date\r\nORDER BY time;",
