      "targets": [
        {
          "dataset": "towerdb",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P78DC24F8AA21B398"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  r.battle_date AS time,\r\n\r\n  MAX(CASE WHEN e.metric = 'golden_bot' THEN e.value END) AS golden_bot,\r\n  MAX(CASE WHEN e.metric = 'golden_tower' THEN e.value END) AS golden_tower,\r\n  MAX(CASE WHEN e.metric = 'black_hole' THEN e.value END) AS black_hole,\r\n  MAX(CASE WHEN e.metric = 'death_wave' THEN e.value END) AS death_wave\r\n\r\nFROM battle_reports r\r\nJOIN battle_economy e ON r.id = e.report_id\r\n\r\nWHERE e.category = 'coins'\r\n  AND $__timeFilter(r.battle_date)\r\n  AND e.metric IN (\r\n    'golden_bot',\r\n    'golden_tower',\r\n    'black_hole',\r\n    'death_wave'\r\n  )\r\n  AND NOT EXISTS (\r\n    SELECT 1\r\n    FROM battle_report_tags rt\r\n    JOIN tags t ON rt.tag_id = t.id\r\n    WHERE rt.report_id = r.id\r\n      AND t.name IN ('dissonance', 'tournament', 'mission')\r\n  )\r\n\r\nGROUP BY r.battle_date\r\nORDER BY time;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
